POSTGRES_DB=room_booking
POSTGRES_USER=room_booking
POSTGRES_PASSWORD=room_booking
POSTGRES_PORT=5432

# ASP.NET Core does not load .env files automatically.
# For local development, configure these with dotnet user-secrets.
# For deployment, configure them as environment variables in the host.
#
# Update the port in the connection string if POSTGRES_PORT is changed above.
# ConnectionStrings__RoomBooking=Host=localhost;Port=5432;Database=room_booking;Username=room_booking;Password=room_booking
#
# AI__Endpoint=https://api.groq.com/openai/v1
# AI__Model=openai/gpt-oss-20b
# AI__ApiKey=YOUR_GROQ_API_KEY
# ASPNETCORE_FORWARDEDHEADERS_ENABLED=true # Required when deployed behind an HTTPS proxy such as Railway.
